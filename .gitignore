# Environments
.venv/
venv/
*.egg-info/

# Python
__pycache__/
*.py[cod]

# Trained policies: 119 MB each, and regenerable (see README).
data/policies/*.npz
data/policies/*.npz.raw
data/policies/*.npz.bak

# Reference PDFs: copyrighted, they do not belong in the repo.
# refs/README.md records what they are; papers/ is a hand-curated set.
refs/*.pdf
papers/

# Staging area for the migration from udesa
_incoming/

# LaTeX build artifacts. main.pdf is NOT ignored on purpose: it is the
# submitted build, and pdflatex deletes it when a run aborts, so git is what
# gets it back.
stall-paper/*.aux
stall-paper/*.fdb_latexmk
stall-paper/*.fls
stall-paper/*.log
stall-paper/*.out
stall-paper/*.blg
stall-paper/*.synctex.gz
